{
  "name": "miso-travel-hub-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:stg": "vite --mode staging",
    "dev:prod": "vite --mode production",
    "build": "tsc -b && vite build",
    "build:dev": "tsc -b && vite build --mode development",
    "build:stg": "tsc -b && vite build --mode staging",
    "preview": "vite preview",
    "docker:build": "docker build -t miso-travel-hub-web .",
    "docker:run": "docker run --rm -p 4173:80 miso-travel-hub-web",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,scss,json}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "cypress open",
    "test:e2e:chrome": "cypress run --browser chrome --headless",
    "test:e2e:firefox": "cypress run --browser firefox --headless",
    "test:e2e:electron": "cypress run --browser electron --headless",
    "test:e2e:cross-browser": "cypress run --browser chrome --headless && cypress run --browser firefox --headless",
    "test:e2e:lighthouse": "cypress run --browser chrome --headless --spec 'cypress/e2e/lighthouse.cy.ts'",
    "test:lighthouse": "lhci autorun",
    "test:a11y": "npm run test:e2e:chrome -- --spec 'cypress/e2e/a11y.cy.ts'",
    "test:summary": "node scripts/test-summary.mjs",
    "test:summary:no-cases": "node scripts/test-summary.mjs --no-cases",
    "test:full": "npm run test:e2e:cross-browser && node scripts/test-summary.mjs",
    "test:full:a11y": "npm run test:e2e:lighthouse && node scripts/test-summary.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "i18next": "^24.2.2",
    "i18next-browser-languagedetector": "^8.0.4",
    "i18next-http-backend": "^3.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.4.1",
    "react-router": "^7.3.0",
    "react-router-dom": "^7.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@lhci/cli": "^0.15.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.11.4",
    "chrome-launcher": "^1.2.1",
    "cypress": "^15.14.2",
    "cypress-axe": "^1.7.0",
    "cypress-real-events": "^1.15.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lighthouse": "^12.8.2",
    "prettier": "^3.5.3",
    "sass": "^1.83.4",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0",
    "wait-on": "^9.0.5"
  }
}
