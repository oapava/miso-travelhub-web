# Version control
.git
.gitignore
.github

# Dependencies (re-installed inside the container)
node_modules
.pnpm-store

# Build output (rebuilt inside the container)
dist

# Environment files — never bake secrets into the image
.env
.env.*
.env.*.local
*.local

# Runtime env placeholder — overwritten by docker-entrypoint.sh at startup
public/env-config.js

# Test artefacts
coverage
__tests__
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
jest.config.ts

# Editor / OS noise
.DS_Store
.idea
.vscode
*.swp
*.swo
Thumbs.db

# Logs
npm-debug.log*
yarn-error.log*
*.log

# Docs
*.md
